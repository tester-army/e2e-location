{
  "expo": {
    "name": "e2e Location",
    "slug": "e2e-location",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "e2elocation",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "ios": {
      "bundleIdentifier": "dev.e2e.location",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.e2e.location",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/e2e-mark.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Inter_400Regular.ttf",
              "./assets/fonts/Inter_500Medium.ttf",
              "./assets/fonts/DMMono_400Regular.ttf",
              "./assets/fonts/DMMono_500Medium.ttf",
              "./assets/fonts/StackSansNotch_400Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Inter_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Inter_500Medium.ttf", "weight": 500 }
                ]
              },
              {
                "fontFamily": "DM Mono",
                "fontDefinitions": [
                  { "path": "./assets/fonts/DMMono_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/DMMono_500Medium.ttf", "weight": 500 }
                ]
              },
              {
                "fontFamily": "Stack Sans Notch",
                "fontDefinitions": [{ "path": "./assets/fonts/StackSansNotch_400Regular.ttf", "weight": 400 }]
              }
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "e2e Location shows the city you're in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
