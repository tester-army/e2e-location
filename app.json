{
  "expo": {
    "name": "e2e location",
    "slug": "e2e-location",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "e2elocation",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "dev.e2e.location",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.e2e.location",
      "adaptiveIcon": {
        "backgroundColor": "#1A5FFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-sign.png",
          "imageWidth": 48
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": ["./assets/fonts/JetBrainsMono_400Regular.ttf"]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono_400Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "e2e location shows the city you're in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
